[Unit]
Description=SPARC Pi 4 Bluetooth and local network companion
After=bluetooth.service NetworkManager.service avahi-daemon.service
Wants=bluetooth.service NetworkManager.service avahi-daemon.service

[Service]
Type=simple
WorkingDirectory=/opt/sparc/controller
ExecStart=/opt/sparc/.venv-controller/bin/python -m sparc_controller
Restart=on-failure
RestartSec=5
# D-Bus network provisioning requires privileged NetworkManager access.
User=root
StateDirectory=sparc-controller
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH
ReadWritePaths=/var/lib/sparc-controller

[Install]
WantedBy=multi-user.target
