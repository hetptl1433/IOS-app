*.py[cod]
.venv/
.venv-*/
*.egg-info/
build/
dist/

# SPARC's working database changes every time the app runs, and `python -m sparc load` rebuilds it
# from comed-data/ in seconds, so git keeps the CSV copy of the prices instead. ai-forecasts/ caches
# AI model forecasts on this computer, so a repeated test takes seconds.
runtime/sparc.db*
runtime/ai-forecasts/

.env
.env.*
.DS_Store

