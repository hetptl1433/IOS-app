DerivedData/
artifacts/
*.xcuserstate
xcuserdata/
*.ipa
*.dSYM/
*.xcarchive/
*.p12
*.mobileprovision

# Per-device controller credentials and Wi-Fi secrets
controller-state/
controller/.venv/
